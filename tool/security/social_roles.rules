// Isolated security fixture. Merge with the actual production rules only after
// reviewing the existing rule set; do not deploy this file as a replacement.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        request.auth.uid in [
          'T4zb6OLzDgMh0qrfp3eEahNKmNl1',
          'lyNcv2xr33Ms6G9fI0bhBEcDKFj2',
          'vLeB8v4b1pUL8h5dtxJSkifF2v72',
          '4LTxrSEmWmNRcGn5paeFfhWRIDi1'
        ]
      );
    }
    function validRoleRequest(uid, role) {
      return owns(uid) &&
        request.resource.data.keys().hasOnly([
          'uid', 'fullName', 'requestedRole', 'status', 'createdAt'
        ]) &&
        request.resource.data.uid == uid &&
        request.resource.data.requestedRole == role &&
        request.resource.data.status == 'pending';
    }

    match /author_requests/{uid} {
      allow get: if owns(uid) || admin();
      allow list: if admin();
      allow create: if validRoleRequest(uid, 'author');
      allow update: if admin() ||
        (resource.data.status == 'rejected' &&
          validRoleRequest(uid, 'author'));
      allow delete: if false;
    }
    match /moderator_requests/{uid} {
      allow get: if owns(uid) || admin();
      allow list: if admin();
      allow create: if validRoleRequest(uid, 'moderator');
      allow update: if admin() ||
        (resource.data.status == 'rejected' &&
          validRoleRequest(uid, 'moderator'));
      allow delete: if false;
    }
    match /author_grants/{uid} {
      allow get: if owns(uid) || admin();
      allow list, write: if admin();
    }
    match /moderator_grants/{uid} {
      allow get: if owns(uid) || admin();
      allow list, write: if admin();
    }

    // This fixture checks the publication gate. Production update/comment/like
    // rules must be merged with the already-deployed rules, not replaced here.
    match /posts/{postId} {
      allow create: if signedIn() &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.status == 'published' &&
        (admin() ||
          get(/databases/$(database)/documents/author_grants/$(request.auth.uid))
            .data.status == 'approved');
    }
  }
}
